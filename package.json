{
  "name": "sharp-image",
  "displayName": "Sharp Image Tools",
  "version": "0.1.0",
  "description": "Convert and edit images from the Explorer context menu using the sharp library",
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "avif",
    "convert",
    "heif",
    "image",
    "jpeg",
    "png",
    "sharp",
    "webp"
  ],
  "homepage": "https://github.com/bhouston/sharp-image-vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/bhouston/sharp-image-vscode-extension/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhouston/sharp-image-vscode-extension"
  },
  "publisher": "benhouston3d",
  "main": "./dist/extension.js",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm run tsc",
    "compile": "tsc -b",
    "watch": "tsc -watch -p ./",
    "tsc": "tsc -b",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "package": "pnpm run compile && node scripts/install-all-platforms.js && vsce package"
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.3.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "sharpImageTools.convertToJpeg",
        "title": "Convert to JPEG"
      },
      {
        "command": "sharpImageTools.convertToPng",
        "title": "Convert to PNG"
      },
      {
        "command": "sharpImageTools.convertToWebp",
        "title": "Convert to WebP"
      },
      {
        "command": "sharpImageTools.convertToGif",
        "title": "Convert to GIF"
      },
      {
        "command": "sharpImageTools.convertToAvif",
        "title": "Convert to AVIF"
      },
      {
        "command": "sharpImageTools.convertToTiff",
        "title": "Convert to TIFF"
      },
      {
        "command": "sharpImageTools.convertToHeif",
        "title": "Convert to HEIF"
      },
      {
        "command": "sharpImageTools.convertToJp2",
        "title": "Convert to JP2"
      },
      {
        "command": "sharpImageTools.rotateCw",
        "title": "Rotate 90° CW"
      },
      {
        "command": "sharpImageTools.rotateCcw",
        "title": "Rotate 90° CCW"
      },
      {
        "command": "sharpImageTools.flip",
        "title": "Flip"
      },
      {
        "command": "sharpImageTools.flop",
        "title": "Flop"
      },
      {
        "command": "sharpImageTools.trim",
        "title": "Trim"
      },
      {
        "command": "sharpImageTools.greyscale",
        "title": "Greyscale"
      },
      {
        "command": "sharpImageTools.negate",
        "title": "Negate"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "sharpImageTools.convertImage",
          "when": "resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i",
          "group": "7_modification"
        },
        {
          "submenu": "sharpImageTools.editImage",
          "when": "resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i",
          "group": "7_modification"
        }
      ],
      "sharpImageTools.convertImage": [
        {
          "command": "sharpImageTools.convertToJpeg",
          "when": "(resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i && resourceExtname != '.jpg' && resourceExtname != '.jpeg') || (listMultiSelection && resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i)"
        },
        {
          "command": "sharpImageTools.convertToPng",
          "when": "(resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i && resourceExtname != '.png') || (listMultiSelection && resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i)"
        },
        {
          "command": "sharpImageTools.convertToWebp",
          "when": "(resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i && resourceExtname != '.webp') || (listMultiSelection && resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i)"
        },
        {
          "command": "sharpImageTools.convertToGif",
          "when": "(resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i && resourceExtname != '.gif') || (listMultiSelection && resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i)"
        },
        {
          "command": "sharpImageTools.convertToAvif",
          "when": "(resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i && resourceExtname != '.avif') || (listMultiSelection && resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i)"
        },
        {
          "command": "sharpImageTools.convertToTiff",
          "when": "(resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i && resourceExtname != '.tiff' && resourceExtname != '.tif') || (listMultiSelection && resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i)"
        },
        {
          "command": "sharpImageTools.convertToHeif",
          "when": "(resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i && resourceExtname != '.heic' && resourceExtname != '.heif') || (listMultiSelection && resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i)"
        },
        {
          "command": "sharpImageTools.convertToJp2",
          "when": "(resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i && resourceExtname != '.jp2') || (listMultiSelection && resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i)"
        }
      ],
      "sharpImageTools.editImage": [
        {
          "command": "sharpImageTools.rotateCw",
          "when": "resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i"
        },
        {
          "command": "sharpImageTools.rotateCcw",
          "when": "resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i"
        },
        {
          "command": "sharpImageTools.flip",
          "when": "resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i"
        },
        {
          "command": "sharpImageTools.flop",
          "when": "resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i"
        },
        {
          "command": "sharpImageTools.trim",
          "when": "resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i"
        },
        {
          "command": "sharpImageTools.greyscale",
          "when": "resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i"
        },
        {
          "command": "sharpImageTools.negate",
          "when": "resourceExtname =~ /\\.(jpg|jpeg|png|webp|gif|avif|tiff|tif|svg|heic|heif|jp2)$/i"
        }
      ]
    },
    "submenus": [
      {
        "id": "sharpImageTools.convertImage",
        "label": "Convert Image"
      },
      {
        "id": "sharpImageTools.editImage",
        "label": "Edit Image"
      }
    ],
    "configuration": {
      "title": "Sharp Image Tools",
      "properties": {
        "sharpImageTools.conversionQuality": {
          "type": "number",
          "default": 95,
          "minimum": 0,
          "maximum": 100,
          "description": "Quality for JPEG, WebP, AVIF and other quality-capable formats (0-100)"
        },
        "sharpImageTools.leaveOriginalWhenChangingFormat": {
          "type": "boolean",
          "default": false,
          "description": "When converting format, leave the original file unchanged and write to a new file (same name, target extension)"
        },
        "sharpImageTools.leaveOriginalWhenEditing": {
          "type": "boolean",
          "default": false,
          "description": "When editing (rotate, flip, etc.), leave the original file unchanged and write to a new file with the editing suffix"
        },
        "sharpImageTools.editingSuffix": {
          "type": "string",
          "default": "-edit",
          "description": "Suffix inserted before the file extension when leaving original on edit (e.g. photo.jpg → photo-edit.jpg). Multiple edits stack: photo-edit.jpg → photo-edit-edit.jpg"
        }
      }
    }
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "packageManager": "pnpm@10.33.0"
}
